<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Subtle backdrop outer battery glow shadow -->
    <path
        android:fillColor="#1F000000"
        android:pathData="M 46,24 C 46,22.9 46.9,22 48,22 H 60 C 61.1,22 62,22.9 62,24 V 30 H 46 Z 
                          M 44,30 H 64 C 67.3,30 70,32.7 70,36 V 78 C 70,81.3 67.3,84 64,84 H 44 C 40.7,84 38,81.3 38,78 V 36 C 38,32.7 40.7,30 44,30 Z" />

    <!-- Battery Level Charging Base (Liquid Mint Green) -->
    <path android:pathData="M 44,48 H 64 C 65.1,48 66,48.9 66,50 V 75 C 66,76.1 65.1,77 64,77 H 44 C 42.9,77 42,76.1 42,75 V 50 C 42,48.9 42.9,48 44,48 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="77"
                android:endX="54"
                android:endY="48">
                <item android:offset="0" android:color="#0EA5E9"/> <!-- Bright sky blue root -->
                <item android:offset="0.5" android:color="#10B981"/> <!-- Emerald Green -->
                <item android:offset="1" android:color="#34D399"/> <!-- Minty active green peak -->
            </gradient>
        </aapt:attr>
    </path>

    <!-- Main Outer Battery Frame (Material You Elegant Purple Stroke) -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#D0BCFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M 46,22 C 46,20.9 46.9,20 48,20 H 60 C 61.1,20 62,20.9 62,22 V 28 H 46 Z" />
    
    <path
        android:fillColor="#15131C"
        android:fillAlpha="0.3"
        android:strokeColor="#D0BCFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M 44,28 H 64 C 67.3,28 70,30.7 70,34 V 76 C 70,79.3 67.3,82 64,82 H 44 C 40.7,82 38,79.3 38,76 V 34 C 38,30.7 40.7,28 44,28 Z" />

    <!-- Bolt Shadow for legibility -->
    <path
        android:fillColor="#4D000000"
        android:pathData="M 59.5,37.5 L 47.5,52.5 H 55.5 L 50.5,67.5 L 61.5,50.5 H 53.5 Z" />

    <!-- Charging Lightning Bolt (Energetic Tech Gold Gradient) -->
    <path android:pathData="M 58,36 L 46,51 H 54 L 49,66 L 60,49 H 52 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="36"
                android:endX="54"
                android:endY="66">
                <item android:offset="0" android:color="#FBBF24"/> <!-- Vivid Yellow -->
                <item android:offset="1" android:color="#F59E0B"/> <!-- Warm Amber Gold -->
            </gradient>
        </aapt:attr>
    </path>

</vector>
