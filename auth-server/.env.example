# eWeLink app credentials (from https://dev.ewelink.cc)
APP_ID=your_app_id_here
APP_SECRET=your_app_secret_here

# SMTP cloud provider (Brevo consigliato: free 300 mail/giorno, no dominio)
# 1. Registrati su https://www.brevo.com (free, no carta)
# 2. Settings -> Senders -> Add sender: verifica l'indirizzo col codice a 6 cifre via email
# 3. Settings -> SMTP & API -> tab SMTP -> Generate SMTP key (visibile una sola volta)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
# Login SMTP Brevo mostrato in Impostazioni SMTP (es. 1234567@smtp-brevo.com)
SMTP_USER=your-smtp-login
# SMTP key Brevo: inizia con xsmtpsib-... (NON la API key xkeysib-...)
SMTP_PASS=your-smtp-key
# Mittente: DEVE essere l'indirizzo verificato in Brevo (From dell'email)
FROM_EMAIL=tuo.indirizzo@gmail.com
# Nome visualizzato nell'email
MAIL_FROM_NAME=VoltGuard Pro
# Opzionale: indirizzo completo custom (se hai dominio verificato)
# MAIL_FROM=VoltGuard Pro <noreply@tuodominio.com>

# Alternativa: invio via API Brevo (API key xkeysib-...), senza SMTP.
# Se in Brevo hai attivato il blocco IP (Settings -> Security -> Authorized IPs)
# autorizza l'IP del server o disattiva il blocco, altrimenti l'API risponde 401.
# BREVO_API_KEY=xkeysib-...

# Fallback opzionale: Resend API key for sending emails
RESEND_API_KEY=your_resend_api_key_here

# Gmail SMTP diretto (consigliato se il mittente è un indirizzo Gmail):
# mittente reale = account Gmail, migliore consegna verso Gmail, limite ~500 mail/giorno.
# 1. Attiva la verifica in due passaggi sull'account Google
# 2. https://myaccount.google.com/apppasswords -> crea App Password (16 caratteri)
# 3. Incolla qui la password (gli spazi vengono rimossi automaticamente)
# Se configurato, Gmail viene usato come mailer principale e Brevo resta come fallback.
# GMAIL_USER=tuo.indirizzo@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Rinnovo automatico — ogni 25/30gg invia mail per rinnovare token da qualsiasi dispositivo
# Intervallo default 25 giorni, ma server invia 5gg prima della scadenza AT (30gg) se atExpiry noto
# Nessuna var richiesta: gestito via API /subscribe-renewal

# Opzionale: secret per cron manuale POST /_cron/renewals (se vuoi trigger da Render Cron o UptimeRobot)
# CRON_SECRET=una-stringa-segreta-casuale

# Public URL of this server (used in email links)
BASE_URL=https://your-server.onrender.com

# Server port
PORT=3000
