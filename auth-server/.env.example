# eWeLink app credentials (from https://dev.ewelink.cc)
APP_ID=your_app_id_here
APP_SECRET=your_app_secret_here

# Gmail SMTP (consigliato su Render) — usa App Password senza spazi
GMAIL_USER=tuo.account@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Nome visualizzato per nascondere info private (immagine profilo va rimossa da myaccount.google.com)
MAIL_FROM_NAME=VoltGuard Pro
# Opzionale: indirizzo completo custom (se hai dominio verificato)
# MAIL_FROM=VoltGuard Pro <noreply@tuodominio.com>

# Alternativa: Resend API key for sending emails
RESEND_API_KEY=your_resend_api_key_here
FROM_EMAIL=login@yourdomain.com

# Public URL of this server (used in email links)
BASE_URL=https://your-server.onrender.com

# Server port
PORT=3000
