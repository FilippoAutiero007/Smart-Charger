# eWeLink app credentials (from https://dev.ewelink.cc)
APP_ID=your_app_id_here
APP_SECRET=your_app_secret_here

# Gmail SMTP (consigliato su Render) — App Password di Google (16 caratteri)
# Google la mostra come "yxyw gmlz llgs icqn" con spazi, ma il codice li rimuove automaticamente
# puoi incollarla con o senza spazi, funziona uguale
GMAIL_USER=tuo.account@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Nome visualizzato per nascondere info private (immagine profilo va rimossa da myaccount.google.com)
MAIL_FROM_NAME=VoltGuard Pro
# Opzionale: indirizzo completo custom (se hai dominio verificato)
# MAIL_FROM=VoltGuard Pro <noreply@tuodominio.com>

# Alternativa: Resend API key for sending emails
RESEND_API_KEY=your_resend_api_key_here
FROM_EMAIL=login@yourdomain.com

# Rinnovo automatico — ogni 25/30gg invia mail per rinnovare token da qualsiasi dispositivo
# Intervallo default 25 giorni, ma server invia 5gg prima della scadenza AT (30gg) se atExpiry noto
# Nessuna var richiesta: gestito via API /subscribe-renewal

# Opzionale: secret per cron manuale POST /_cron/renewals (se vuoi trigger da Render Cron o UptimeRobot)
# CRON_SECRET=una-stringa-segreta-casuale

# Public URL of this server (used in email links)
BASE_URL=https://your-server.onrender.com

# Server port
PORT=3000
